{
  "name": "bolt-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env EXPO_NO_TELEMETRY=1 npx expo start",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && cross-env EXPO_NO_TELEMETRY=1 EXPO_NO_WEB_SETUP=0 npx expo export --platform web",
    "build:web": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && cross-env EXPO_NO_TELEMETRY=1 EXPO_NO_WEB_SETUP=0 npx expo export --platform web",
    "lint": "npx expo lint",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "npx expo prebuild --platform android",
    "setup:sdk": "node setup-android-sdk.js",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "~58.0.25",
    "expo-blur": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.11",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-location": "^58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "lucide-react-native": "^0.544.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
